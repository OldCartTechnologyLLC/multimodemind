{
  "name": "multimodemind",
  "version": "0.5.0",
  "description": "Multi-store memory layer for AI agents, exposed over MCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mmind": "dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "tsc -p tsconfig.check.json",
    "eval": "tsx eval/run.ts",
    "eval:explain": "tsx eval/probe.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "test:mcp": "npm run build && node tests/mcp-smoke.mjs",
    "prepublishOnly": "npm run build",
    "test:audit": "npm run build && node tests/audit-selftest.mjs"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai-agent",
    "sqlite",
    "vector",
    "leveldb",
    "obsidian"
  ],
  "author": "Old Cart Technology LLC",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "level": "^10.0.0",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "vectra": "^0.15.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "adm-zip": ">=0.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
